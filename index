<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap" rel="stylesheet">
<style>
  html, body { margin: 0; padding: 0; background: #17110D; }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  a { color: #E2452B; text-decoration: none; }
  a:hover { color: #17110D; }
  @keyframes bpop { 0% { transform: scale(0.4); opacity: 0 } 40% { transform: scale(1.12); opacity: 1 } 100% { transform: scale(1); opacity: 1 } }
  @keyframes bflash { 0% { opacity: 0.95 } 100% { opacity: 0 } }
  @keyframes bfade { 0% { opacity: 0; transform: translateY(10px) } 100% { opacity: 1; transform: none } }
</style>
</helmet>
<div style="min-height: 100vh; background: #17110D; display: flex; align-items: stretch; justify-content: center; font-family: 'IBM Plex Sans Thai', sans-serif; color: #17110D;">
  <div style="width: 100%; max-width: 520px; background: #F4EFE6; display: flex; flex-direction: column; position: relative; overflow: hidden;">

    <div style="display: flex; align-items: center; justify-content: space-between; padding: 18px 20px 14px; border-bottom: 1.5px solid #17110D;">
      <div style="display: flex; align-items: baseline; gap: 8px;">
        <div style="font-size: 19px; font-weight: 700; letter-spacing: -0.01em;">&nbsp;โฟโต้บูธ</div>
        <div style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.16em; color: #8A7F72; text-transform: uppercase;">est. 2026</div>
      </div>
      <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.1em; color: #E2452B;">{{ stepLabel }}</div>
    </div>

    <sc-if value="{{ isWelcome }}" hint-placeholder-val="{{ true }}">
      <div style="flex: 1; display: flex; flex-direction: column; justify-content: space-between; padding: 32px 24px 28px; animation: bfade 0.35s ease both;">
        <div style="display: flex; flex-direction: column; gap: 18px;">
          <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.22em; color: #8A7F72;">4 ช็อต · 20 วินาที</div>
          <div style="font-size: 46px; line-height: 1.02; font-weight: 700; letter-spacing: -0.03em; text-wrap: pretty;">ถ่ายรูป<br>ให้เป็น<span style="color: #E2452B;">สตริป</span></div>
          <div style="font-size: 15px; line-height: 1.55; color: #4A4038; max-width: 34ch;">ยืนหน้ากล้อง กดเริ่ม แล้วยิ้มตามจังหวะนับถอยหลัง ได้ไฟล์สตริปพร้อมเซฟทันที</div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 28px 0;">
          <div style="border: 1.5px solid #17110D; padding: 12px 10px; display: flex; flex-direction: column; gap: 4px;">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: 18px;">01</div>
            <div style="font-size: 12px; line-height: 1.4; color: #4A4038;">เลือกเลย์เอาต์</div>
          </div>
          <div style="border: 1.5px solid #17110D; padding: 12px 10px; display: flex; flex-direction: column; gap: 4px;">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: 18px;">02</div>
            <div style="font-size: 12px; line-height: 1.4; color: #4A4038;">ถ่ายต่อเนื่อง</div>
          </div>
          <div style="border: 1.5px solid #17110D; padding: 12px 10px; display: flex; flex-direction: column; gap: 4px;">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: 18px;">03</div>
            <div style="font-size: 12px; line-height: 1.4; color: #4A4038;">ดาวน์โหลด</div>
          </div>
        </div>

        <button onClick="{{ goSetup }}" style="width: 100%; border: none; background: #17110D; color: #F4EFE6; font-family: 'IBM Plex Sans Thai', sans-serif; font-size: 17px; font-weight: 600; padding: 20px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; transition: background 0.15s ease;" style-hover="background: #E2452B;">
          <span>เริ่มถ่าย</span>
          <span style="font-family: 'IBM Plex Mono', monospace; font-size: 13px;">→</span>
        </button>
      </div>
    </sc-if>

    <sc-if value="{{ isSetup }}" hint-placeholder-val="{{ false }}">
      <div style="flex: 1; display: flex; flex-direction: column; padding: 24px 20px 20px; gap: 22px; animation: bfade 0.3s ease both;">
        <div style="display: flex; flex-direction: column; gap: 10px;">
          <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.18em; color: #8A7F72;">เลย์เอาต์</div>
          <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px;">
            <sc-for list="{{ layouts }}" as="lo" hint-placeholder-count="4">
              <button onClick="{{ lo.pick }}" style="{{ lo.btnStyle }}">
                <div style="{{ lo.thumbStyle }}"></div>
                <div style="font-size: 11px; font-weight: 600; line-height: 1.2;">{{ lo.name }}</div>
              </button>
            </sc-for>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 10px;">
          <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.18em; color: #8A7F72;">ฟิลเตอร์</div>
          <div style="display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px;">
            <sc-for list="{{ filters }}" as="f" hint-placeholder-count="5">
              <button onClick="{{ f.pick }}" style="{{ f.btnStyle }}">{{ f.name }}</button>
            </sc-for>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 10px;">
          <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.18em; color: #8A7F72;">สีกรอบ</div>
          <div style="display: flex; gap: 10px;">
            <sc-for list="{{ frames }}" as="fr" hint-placeholder-count="4">
              <button onClick="{{ fr.pick }}" style="{{ fr.btnStyle }}"></button>
            </sc-for>
          </div>
        </div>

        <div style="margin-top: auto; display: flex; gap: 10px;">
          <button onClick="{{ goWelcome }}" style="border: 1.5px solid #17110D; background: transparent; color: #17110D; font-family: 'IBM Plex Sans Thai', sans-serif; font-size: 15px; font-weight: 600; padding: 18px 22px; cursor: pointer;">ย้อนกลับ</button>
          <button onClick="{{ goShoot }}" style="flex: 1; border: none; background: #E2452B; color: #F4EFE6; font-family: 'IBM Plex Sans Thai', sans-serif; font-size: 17px; font-weight: 600; padding: 18px; cursor: pointer; transition: background 0.15s ease;" style-hover="background: #17110D;">เปิดกล้อง</button>
        </div>
      </div>
    </sc-if>

    <sc-if value="{{ isShoot }}" hint-placeholder-val="{{ false }}">
      <div style="flex: 1; display: flex; flex-direction: column;">
        <div style="position: relative; background: #17110D; overflow: hidden; aspect-ratio: 3 / 4;">
          <video ref="{{ videoRef }}" autoPlay="{{ true }}" playsInline="{{ true }}" muted="{{ true }}" style="{{ videoStyle }}"></video>
          <div style="{{ flashStyle }}"></div>

          <sc-if value="{{ camError }}" hint-placeholder-val="{{ false }}">
            <div style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 28px; text-align: center; background: #17110D; color: #F4EFE6;">
              <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.2em; color: #E2452B;">ไม่พบกล้อง</div>
              <div style="font-size: 14px; line-height: 1.55; color: #C9BFB2; max-width: 30ch;">เบราว์เซอร์ยังไม่อนุญาตให้ใช้กล้อง กดอนุญาตแล้วลองใหม่ หรือลองโหมดตัวอย่างก่อน</div>
              <div style="display: flex; gap: 8px; margin-top: 4px;">
                <button onClick="{{ retryCam }}" style="border: 1.5px solid #F4EFE6; background: transparent; color: #F4EFE6; font-family: 'IBM Plex Sans Thai', sans-serif; font-size: 14px; font-weight: 600; padding: 12px 18px; cursor: pointer;">ลองอีกครั้ง</button>
                <button onClick="{{ demoMode }}" style="border: none; background: #E2452B; color: #F4EFE6; font-family: 'IBM Plex Sans Thai', sans-serif; font-size: 14px; font-weight: 600; padding: 12px 18px; cursor: pointer;">โหมดตัวอย่าง</button>
              </div>
            </div>
          </sc-if>

          <sc-if value="{{ countdown }}" hint-placeholder-val="{{ false }}">
            <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none;">
              <div style="{{ countStyle }}">{{ countdown }}</div>
            </div>
          </sc-if>

          <div style="position: absolute; top: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; background: linear-gradient(#17110Dcc, transparent);">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.14em; color: #F4EFE6;">{{ shotCounter }}</div>
            <div style="display: flex; gap: 5px;">
              <sc-for list="{{ dots }}" as="d" hint-placeholder-count="4">
                <div style="{{ d.style }}"></div>
              </sc-for>
            </div>
          </div>
        </div>

        <div style="flex: 1; display: flex; flex-direction: column; gap: 16px; padding: 18px 20px 22px;">
          <div style="display: flex; gap: 6px; overflow-x: auto;">
            <sc-for list="{{ shotThumbs }}" as="t" hint-placeholder-count="4">
              <div style="{{ t.wrapStyle }}">
                <img src="{{ t.src }}" alt="" style="{{ t.imgStyle }}">
                <div style="{{ t.numStyle }}">{{ t.num }}</div>
              </div>
            </sc-for>
          </div>

          <div style="display: flex; gap: 10px; margin-top: auto;">
            <button onClick="{{ goSetup }}" style="border: 1.5px solid #17110D; background: transparent; color: #17110D; font-family: 'IBM Plex Sans Thai', sans-serif; font-size: 15px; font-weight: 600; padding: 18px 20px; cursor: pointer;">ตั้งค่า</button>
            <button onClick="{{ startSequence }}" disabled="{{ shooting }}" style="{{ shootBtnStyle }}">{{ shootBtnLabel }}</button>
          </div>
        </div>
      </div>
    </sc-if>

    <sc-if value="{{ isResult }}" hint-placeholder-val="{{ false }}">
      <div style="flex: 1; display: flex; flex-direction: column; padding: 22px 20px 22px; gap: 18px; animation: bfade 0.35s ease both;">
        <div style="flex: 1; display: flex; align-items: center; justify-content: center; min-height: 0;">
          <img src="{{ stripUrl }}" alt="สตริปรูปถ่าย" style="max-width: 100%; max-height: 52vh; box-shadow: 0 18px 40px #17110D33;">
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <a href="{{ stripUrl }}" download="photobooth-strip.png" style="border: none; background: #17110D; color: #F4EFE6; font-family: 'IBM Plex Sans Thai', sans-serif; font-size: 17px; font-weight: 600; padding: 20px; cursor: pointer; text-align: center; transition: background 0.15s ease;" style-hover="background: #E2452B; color: #F4EFE6;">ดาวน์โหลดสตริป</a>
          <div style="display: flex; gap: 8px;">
            <button onClick="{{ goShoot }}" style="flex: 1; border: 1.5px solid #17110D; background: transparent; color: #17110D; font-family: 'IBM Plex Sans Thai', sans-serif; font-size: 15px; font-weight: 600; padding: 16px; cursor: pointer;">ถ่ายใหม่</button>
            <button onClick="{{ goSetup }}" style="flex: 1; border: 1.5px solid #17110D; background: transparent; color: #17110D; font-family: 'IBM Plex Sans Thai', sans-serif; font-size: 15px; font-weight: 600; padding: 16px; cursor: pointer;">เปลี่ยนสไตล์</button>
          </div>
        </div>
      </div>
    </sc-if>

  </div>
</div>

</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;$preview&quot;:{&quot;width&quot;:520,&quot;height&quot;:900},&quot;mirrorSelfie&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;กล้อง&quot;},&quot;countdownSeconds&quot;:{&quot;editor&quot;:&quot;int&quot;,&quot;default&quot;:3,&quot;min&quot;:1,&quot;max&quot;:6,&quot;unit&quot;:&quot;s&quot;,&quot;tsType&quot;:&quot;number&quot;,&quot;section&quot;:&quot;กล้อง&quot;},&quot;showDateStamp&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;สตริป&quot;},&quot;filmGrain&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;สตริป&quot;}}">
const LAYOUTS = [
  { id: 'strip4', name: 'สตริป 4', shots: 4, cols: 1, ratio: 4 / 3 },
  { id: 'strip3', name: 'สตริป 3', shots: 3, cols: 1, ratio: 4 / 3 },
  { id: 'grid4', name: 'กริด 4', shots: 4, cols: 2, ratio: 1 },
  { id: 'single', name: 'เดี่ยว', shots: 1, cols: 1, ratio: 4 / 5 },
];

const FILTERS = [
  { id: 'none', name: 'ต้นฉบับ', css: 'none' },
  { id: 'bw', name: 'ขาวดำ', css: 'grayscale(1) contrast(1.15)' },
  { id: 'warm', name: 'ฟิล์มอุ่น', css: 'sepia(0.35) saturate(1.25) contrast(1.05)' },
  { id: 'cool', name: 'เย็น', css: 'saturate(0.85) hue-rotate(-12deg) brightness(1.05)' },
  { id: 'faded', name: 'ซีด', css: 'contrast(0.85) brightness(1.12) saturate(0.8)' },
  { id: 'punch', name: 'จัดจ้าน', css: 'saturate(1.6) contrast(1.2)' },
];

const FRAMES = [
  { id: 'cream', paper: '#F4EFE6', ink: '#17110D' },
  { id: 'ink', paper: '#17110D', ink: '#F4EFE6' },
  { id: 'red', paper: '#E2452B', ink: '#F9EDE7' },
  { id: 'sage', paper: '#B9C4AE', ink: '#1E2419' },
];

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

class Component extends DCLogic {
  state = {
    screen: 'welcome',
    layoutId: 'strip4',
    filterId: 'warm',
    frameId: 'cream',
    shots: [],
    countdown: 0,
    flash: false,
    shooting: false,
    camError: false,
    demo: false,
    stripUrl: '',
  };

  videoRef = React.createRef();

  componentWillUnmount() { this.stopCam(); }

  get layout() { return LAYOUTS.find((l) => l.id === this.state.layoutId) || LAYOUTS[0]; }
  get filter() { return FILTERS.find((f) => f.id === this.state.filterId) || FILTERS[0]; }
  get frame() { return FRAMES.find((f) => f.id === this.state.frameId) || FRAMES[0]; }

  async startCam() {
    if (this.stream) return true;
    try {
      const s = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: 'user', width: { ideal: 1280 }, height: { ideal: 960 } },
        audio: false,
      });
      this.stream = s;
      this.setState({ camError: false, demo: false });
      await sleep(30);
      const v = this.videoRef.current;
      if (v) { v.srcObject = s; try { await v.play(); } catch (e) {} }
      return true;
    } catch (e) {
      this.setState({ camError: true });
      return false;
    }
  }

  stopCam() {
    if (this.stream) { this.stream.getTracks().forEach((t) => t.stop()); this.stream = null; }
  }

  cellSize() {
    const w = 900;
    return { w, h: Math.round(w / this.layout.ratio) };
  }

  grabFrame() {
    const { w, h } = this.cellSize();
    const c = document.createElement('canvas');
    c.width = w; c.height = h;
    const ctx = c.getContext('2d');
    const v = this.videoRef.current;
    if (this.state.demo || !v || !v.videoWidth) {
      const hue = 20 + this.state.shots.length * 42;
      const g = ctx.createLinearGradient(0, 0, w, h);
      g.addColorStop(0, 'hsl(' + hue + ' 45% 62%)');
      g.addColorStop(1, 'hsl(' + (hue + 30) + ' 35% 34%)');
      ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
      ctx.fillStyle = 'rgba(255,255,255,0.85)';
      ctx.font = '600 44px "IBM Plex Sans Thai", sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('ตัวอย่าง ' + (this.state.shots.length + 1), w / 2, h / 2 + 14);
      return c.toDataURL('image/jpeg', 0.92);
    }
    const vw = v.videoWidth, vh = v.videoHeight;
    const target = w / h;
    let sw = vw, sh = vw / target;
    if (sh > vh) { sh = vh; sw = vh * target; }
    const sx = (vw - sw) / 2, sy = (vh - sh) / 2;
    if (this.props.mirrorSelfie !== false) { ctx.translate(w, 0); ctx.scale(-1, 1); }
    try { ctx.filter = this.filter.css; } catch (e) {}
    ctx.drawImage(v, sx, sy, sw, sh, 0, 0, w, h);
    return c.toDataURL('image/jpeg', 0.92);
  }

  async startSequence() {
    if (this.state.shooting) return;
    this.setState({ shooting: true, shots: [] });
    const secs = Math.max(1, Number(this.props.countdownSeconds) || 3);
    for (let i = 0; i < this.layout.shots; i++) {
      for (let n = secs; n > 0; n--) { this.setState({ countdown: n }); await sleep(900); }
      this.setState({ countdown: 0, flash: true });
      const shot = this.grabFrame();
      this.setState((s) => ({ shots: s.shots.concat(shot) }));
      await sleep(160);
      this.setState({ flash: false });
      await sleep(600);
    }
    const url = await this.compose();
    this.setState({ shooting: false, stripUrl: url, screen: 'result' });
    this.stopCam();
  }

  async compose() {
    const lo = this.layout, fr = this.frame;
    const { w: cw, h: ch } = this.cellSize();
    const cols = lo.cols, rows = Math.ceil(lo.shots / cols);
    const pad = 44, gap = 26, footer = 150;
    const W = pad * 2 + cw * cols + gap * (cols - 1);
    const H = pad + ch * rows + gap * (rows - 1) + footer;
    const c = document.createElement('canvas');
    c.width = W; c.height = H;
    const ctx = c.getContext('2d');
    ctx.fillStyle = fr.paper; ctx.fillRect(0, 0, W, H);

    const imgs = await Promise.all(this.state.shots.map((src) => new Promise((res) => {
      const im = new Image(); im.onload = () => res(im); im.onerror = () => res(null); im.src = src;
    })));

    imgs.forEach((im, i) => {
      const x = pad + (i % cols) * (cw + gap);
      const y = pad + Math.floor(i / cols) * (ch + gap);
      ctx.fillStyle = 'rgba(0,0,0,0.08)';
      ctx.fillRect(x, y, cw, ch);
      if (im) ctx.drawImage(im, x, y, cw, ch);
    });

    if (this.props.filmGrain !== false) {
      const n = Math.round(W * H * 0.02);
      ctx.globalAlpha = 0.05;
      for (let i = 0; i < n; i++) {
        ctx.fillStyle = Math.random() > 0.5 ? '#fff' : '#000';
        ctx.fillRect(Math.random() * W, Math.random() * H, 1.5, 1.5);
      }
      ctx.globalAlpha = 1;
    }

    const fy = H - footer + 56;
    ctx.fillStyle = fr.ink;
    ctx.textAlign = 'center';
    ctx.font = '700 46px "IBM Plex Sans Thai", sans-serif';
    ctx.fillText('นิติรัตน์ โฟโต้บูธ', W / 2, fy);
    if (this.props.showDateStamp !== false) {
      const d = new Date();
      const stamp = d.toLocaleDateString('th-TH', { day: '2-digit', month: 'short', year: 'numeric' }) +
        ' · ' + d.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
      ctx.globalAlpha = 0.62;
      ctx.font = '500 28px "IBM Plex Mono", monospace';
      ctx.fillText(stamp, W / 2, fy + 44);
      ctx.globalAlpha = 1;
    }
    return c.toDataURL('image/png');
  }

  renderVals() {
    const st = this.state;
    const lo = this.layout, fl = this.filter;
    const active = (on) => on
      ? 'border: 1.5px solid #17110D; background: #17110D; color: #F4EFE6;'
      : 'border: 1.5px solid #17110D; background: transparent; color: #17110D;';

    const thumb = (l) => {
      const rows = Math.ceil(l.shots / l.cols);
      return 'width: 100%; height: 34px; display: grid; gap: 2px; grid-template-columns: repeat(' + l.cols + ', 1fr); grid-template-rows: repeat(' + rows + ', 1fr); opacity: 0.9;' +
        'background: currentColor; background-clip: content-box;';
    };

    return {
      stepLabel: { welcome: '01 / เริ่ม', setup: '02 / สไตล์', shoot: '03 / ถ่าย', result: '04 / เสร็จ' }[st.screen],
      isWelcome: st.screen === 'welcome',
      isSetup: st.screen === 'setup',
      isShoot: st.screen === 'shoot',
      isResult: st.screen === 'result',

      goWelcome: () => { this.stopCam(); this.setState({ screen: 'welcome', shots: [], stripUrl: '' }); },
      goSetup: () => { this.stopCam(); this.setState({ screen: 'setup', shots: [], stripUrl: '' }); },
      goShoot: () => { this.setState({ screen: 'shoot', shots: [], stripUrl: '' }); this.startCam(); },
      retryCam: () => { this.stopCam(); this.setState({ camError: false }); this.startCam(); },
      demoMode: () => this.setState({ demo: true, camError: false }),
      startSequence: () => this.startSequence(),

      layouts: LAYOUTS.map((l) => ({
        name: l.name,
        pick: () => this.setState({ layoutId: l.id, shots: [] }),
        btnStyle: 'display: flex; flex-direction: column; gap: 8px; align-items: stretch; padding: 10px 8px; cursor: pointer; font-family: inherit; ' + active(l.id === st.layoutId),
        thumbStyle: thumb(l),
      })),

      filters: FILTERS.map((f) => ({
        name: f.name,
        pick: () => this.setState({ filterId: f.id }),
        btnStyle: 'flex: 0 0 auto; padding: 11px 15px; font-family: inherit; font-size: 13px; font-weight: 600; cursor: pointer; white-space: nowrap; ' + active(f.id === st.filterId),
      })),

      frames: FRAMES.map((f) => ({
        pick: () => this.setState({ frameId: f.id }),
        btnStyle: 'width: 44px; height: 44px; cursor: pointer; background: ' + f.paper + '; border: ' + (f.id === st.frameId ? '3px solid #E2452B' : '1.5px solid #17110D') + ';',
      })),

      videoRef: this.videoRef,
      videoStyle: 'width: 100%; height: 100%; object-fit: cover; display: block; filter: ' + fl.css +
        '; transform: ' + (this.props.mirrorSelfie === false ? 'none' : 'scaleX(-1)') + ';',
      flashStyle: 'position: absolute; inset: 0; background: #fff; pointer-events: none; opacity: 0; ' +
        (st.flash ? 'animation: bflash 0.5s ease-out both;' : ''),
      camError: st.camError,
      countdown: st.countdown || false,
      countStyle: 'font-family: "IBM Plex Mono", monospace; font-size: 132px; font-weight: 500; color: #F4EFE6; text-shadow: 0 6px 30px rgba(0,0,0,0.45); animation: bpop 0.5s ease both;',
      shotCounter: String(Math.min(st.shots.length + (st.shooting ? 1 : 0), lo.shots)).padStart(2, '0') + ' / ' + String(lo.shots).padStart(2, '0'),
      dots: Array.from({ length: lo.shots }, (_, i) => ({
        style: 'width: 22px; height: 4px; background: ' + (i < st.shots.length ? '#E2452B' : 'rgba(244,239,230,0.35)') + ';',
      })),
      shotThumbs: Array.from({ length: lo.shots }, (_, i) => ({
        src: st.shots[i] || '',
        num: String(i + 1),
        wrapStyle: 'position: relative; flex: 1 1 0; aspect-ratio: 1; border: 1.5px solid ' + (st.shots[i] ? '#17110D' : 'rgba(23,17,13,0.25)') + '; overflow: hidden; background: #E8E1D5;',
        imgStyle: 'width: 100%; height: 100%; object-fit: cover; display: ' + (st.shots[i] ? 'block' : 'none') + ';',
        numStyle: 'position: absolute; inset: 0; display: ' + (st.shots[i] ? 'none' : 'flex') + '; align-items: center; justify-content: center; font-family: "IBM Plex Mono", monospace; font-size: 13px; color: #8A7F72;',
      })),
      shooting: st.shooting,
      shootBtnLabel: st.shooting ? 'กำลังถ่าย…' : (st.camError ? 'อนุญาตกล้องก่อน' : 'เริ่มนับถอยหลัง'),
      shootBtnStyle: 'flex: 1; border: none; font-family: inherit; font-size: 17px; font-weight: 600; padding: 18px; cursor: ' + (st.shooting ? 'default' : 'pointer') +
        '; background: ' + (st.shooting ? '#8A7F72' : '#E2452B') + '; color: #F4EFE6;',
      stripUrl: st.stripUrl,
    };
  }
}

</script>
</body>
</html>
